APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Storage
# Place the downloaded service-account JSON file under storage/app/ and set the filename below.
FIREBASE_CREDENTIALS_FILE=storage/app/lrf.json

# Google Sheets API (service account)
# Place the downloaded service-account JSON file under storage/app/ and set the filename below.
GOOGLE_SHEETS_CREDENTIALS_FILE=lrfbe-spreadsheet.json
GOOGLE_SHEETS_APPLICATION_NAME="${APP_NAME}"
# Global spreadsheet ID — all sheets are created as tabs inside this one spreadsheet.
# Get it from the sheet URL: /spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_EMPLOYEES_ID=
GOOGLE_SHEETS_ATTENDANCE_ID=
GOOGLE_SHEETS_ATTENDANCE_EMPLOYEES_ID=
GOOGLE_SHEETS_ATTENDANCE_SUB_SEGMENTS_ID=
GOOGLE_SHEETS_SEGMENTS_ID=
GOOGLE_SHEETS_CONSTRUCTION_SITES_ID=
GOOGLE_SHEETS_SITE_ASSIGNMENTS_ID=
GOOGLE_SHEETS_SITE_SUB_CONTRACTORS_ID=
GOOGLE_SHEETS_SUB_CONTRACTORS_ID=
GOOGLE_SHEETS_SUB_CONTRACTOR_WORKERS_ID=
GOOGLE_SHEETS_TRANSPORTATION_EXPENSES_ID=
GOOGLE_SHEETS_RATES_ID=
GOOGLE_SHEETS_OCR_UPLOADS_ID=
GOOGLE_SHEETS_OCR_UPLOAD_CATEGORIES_ID=
GOOGLE_SHEETS_COMPANY_CALENDAR_ID=
GOOGLE_SHEETS_DAY_TYPES_ID=
GOOGLE_SHEETS_SITE_EXPENSE_CATEGORIES_ID=
GOOGLE_SHEETS_SYSTEM_SETTINGS_ID=

# Google Cloud Vision — OCR pre-processing step before Claude (reuses the
# google_sheets service account above; that account must also have the
# Vision API enabled in its GCP project)
GOOGLE_VISION_ENABLED=false

# Invoice OCR LLM-vision extraction — either provider can be active; switch
# with VISION_PROVIDER without deleting the other's config.
VISION_PROVIDER=gemini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
